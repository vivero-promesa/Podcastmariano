# Copia este archivo como .env y pon tu clave (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Opcional: modelo de Gemini (por defecto gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Opcional: voz IA de edge-tts (por defecto es-CO-SalomeNeural)
VOZ_IA=es-CO-SalomeNeural

# Opcional: publicar desde la app (ver README, «Publicar desde la app»)
INSTAGRAM_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_REFRESH_TOKEN=
TIKTOK_MODO=borrador
